# Copy this file to .env and fill it in. .env is git-ignored: never commit keys.
# Everything is optional: with nothing set, Turnout runs with simulated PayPal and a rule-based match.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox → Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY=GBP

# Azure OpenAI chat deployment (endpoint looks like https://<resource>.services.ai.azure.com)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-chat-latest
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Signs the door codes. Any long random string; a new one is made at each start if empty.
CHECKIN_SECRET=

PORT=3000
